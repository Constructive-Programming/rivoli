// Append one token's latent as fp8-e4m3 + per-128 block scales (lc8/lscale) and its
// roped key as bf16 (rc), at row `pos`. GLSL twin of fwd.hip::append_kv.
//
// STRUCTURAL DIVERGENCE FROM THE HIP ORIGINAL, deliberately. The HIP kernel launches
// `kvl` threads with `kvl` floats of DYNAMIC shared memory and reduces each 128-block
// in LDS. GLSL has no dynamic shared memory, and sizing the workgroup to `kvl` would
// either need a specialization constant plus a pipeline per `kvl`, or a fixed 1024
// threads — which would raise this backend's device requirement from
// maxComputeWorkGroupInvocations >= 256 to >= 1024 for one kernel, on a port whose
// entire purpose is portability.
//
// Instead: a fixed 256-thread workgroup, one SUBGROUP per 128-element block (kvl <= 1024
// means at most 8 blocks, and 256/WAVE = 8 subgroups), each lane folding 4 elements and
// finishing with the wave_max ladder.
//
// The results are IDENTICAL, not merely close: the only reduction is a maximum, which
// is exact and order-independent, so no rounding depends on the tree shape. Everything
// after it — the divide, f2e4m3, f2bf16 — is elementwise.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require

#include "common.glsl"

#define THREADS (ROWS_PER_BLOCK * WAVE)
#define KV_BLOCK 128
#define MAX_BLOCKS 8   // kvl <= 1024, enforced by the launcher's argument guard

layout(local_size_x = THREADS) in;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer RwU32 { uint v[]; };

layout(push_constant) uniform Push {
    RoF32 latent;
    RoF32 rope;
    RwU32 lc8;    // bytes, addressed as words
    RwF32 lscale;
    RwU32 rc;     // u16, addressed as words
    int pos;
    int kvl;
    int ropn;
    int n_blocks;
} pc;

shared float sscale[MAX_BLOCKS];

void main() {
    uint t = gl_LocalInvocationID.x;
    uint b = gl_SubgroupID;          // one subgroup per 128-element block
    uint lane = gl_SubgroupInvocationID;

    // ---- per-block amax -> scale ----
    // Every subgroup runs the ladder (it must, wave_max shuffles across the whole
    // subgroup), but only b < n_blocks contributes a real value.
    float a = 0.0;
    if (b < uint(pc.n_blocks)) {
        for (uint k = lane; k < uint(KV_BLOCK); k += WAVE) {
            a = max(a, abs(pc.latent.v[b * uint(KV_BLOCK) + k]));
        }
    }
    a = wave_max(a);
    if (lane == 0u && b < uint(pc.n_blocks)) {
        // amax == 0 -> scale 1.0, not 0: an all-zero block must quantize to zeros
        // rather than divide by zero.
        float scl = a > 0.0 ? a / 448.0 : 1.0;
        sscale[b] = scl;
        pc.lscale.v[uint(pc.pos) * uint(pc.n_blocks) + b] = scl;
    }
    barrier();

    // ---- quantize the latent ----
    // lc8 is bytes; each thread owns whole 4-byte words so no two threads read-modify-
    // write the same word. THREADS*4 = 1024 bytes per pass covers kvl in one pass, but
    // the loop is written generally.
    uint words = uint(pc.kvl) / 4u;
    uint row = uint(pc.pos) * uint(pc.kvl);
    for (uint w = t; w < words; w += THREADS) {
        uint packed = 0u;
        for (uint j = 0u; j < 4u; ++j) {
            uint i = w * 4u + j;
            float q = pc.latent.v[i] / sscale[i / uint(KV_BLOCK)];
            packed |= f2e4m3(q) << (j * 8u);
        }
        pc.lc8.v[row / 4u + w] = packed;
    }

    // ---- roped key as bf16 ----
    // rc is u16; each thread owns a whole word = two consecutive keys.
    uint rwords = uint(pc.ropn) / 2u;
    uint rrow = uint(pc.pos) * uint(pc.ropn);
    for (uint w = t; w < rwords; w += THREADS) {
        uint lo = f2bf16(pc.rope.v[w * 2u]);
        uint hi = f2bf16(pc.rope.v[w * 2u + 1u]);
        pc.rc.v[rrow / 2u + w] = lo | (hi << 16);
    }
}
