// x[o] += gain · (Σ_r acc[r][o]) · 2^-MOE_ACC_SHIFT, resetting acc. GLSL twin of
// moe.hip::moe_acc_drain.
//
// This is the residual add on a MoE layer, not a separate convert pass — folding the two
// is what let the cross-stream join go: the only step that needs every expert now sits
// behind the end-of-layer barrier that already existed.
//
// THE PARTITION CARRIES NO FREEDOM. The f32 `moe_reduce` this replaced (deleted 2026-08-01,
// off the decode path since the accumulator landed) needed each expert to own a row and
// summed rows in a fixed order, because f32 addition does not associate. Here every expert
// on a stream ADDS INTO one row, out of order, concurrently — and that is safe because the
// adds are integers at a fixed scale, so they associate exactly. The schedule cannot reach
// the result because there is no rounding for it to reorder. `rows` is one per stream (a
// contention split, see gpu.rs::MOE_ACC_ROWS), summed here ascending.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "common.glsl"

layout(local_size_x = ROWS_PER_BLOCK * WAVE) in;

layout(push_constant) uniform Push {
    RwF32 x;
    RwU64 acc;
    int n;
    int rows;
    float gain;
} pc;

void main() {
    uint o = gl_GlobalInvocationID.x;
    if (o >= uint(pc.n)) return;
    int64_t t = 0;
    for (uint r = 0u; r < uint(pc.rows); ++r) {
        t += int64_t(pc.acc.v[r * uint(pc.n) + o]);
        pc.acc.v[r * uint(pc.n) + o] = 0ul;
    }
    // double, not float: the accumulator reaches 2^48 and f32 would round it away.
    pc.x.v[o] += pc.gain * float(double(t) / double(MOE_ACC_SCALE));
}
