// Record the FIRST tag whose buffer held a non-finite value. GLSL twin of
// fwd.hip::flag_nonfinite.
//
// The NaN localizer: every layer calls this on the residual stream with its own tag, the
// flag rides the argmax D2H the tail already pays, and the tag that lands names the layer
// that first went non-finite. No sync, no readback of its own — which is the whole reason
// it exists rather than a host-side check (see fwd.hip, and docs/NAN.md if it has landed).
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
// buffer_reference2 is what permits an ATOMIC on a buffer-reference member. Without it
// glslc rejects `atomicCompSwap(pc.flag.v[0], ...)`.
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "common.glsl"

layout(buffer_reference, std430, buffer_reference_align = 4) buffer RwU32f { uint v[]; };

layout(local_size_x = ROWS_PER_BLOCK * WAVE) in;

layout(push_constant) uniform Push {
    RoF32 x;
    RwU32f flag;
    int n;
    uint tag;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.n)) return;
    float v = pc.x.v[i];
    // +inf spelled by its bit pattern rather than `1.0 / 0.0`: the literal division would
    // be constant-folded, but build.rs's reciprocal-rewrite guard reads every OpFMul
    // against a reciprocal constant and a divide-by-zero in the source is exactly the
    // shape it exists to interrogate. This is unambiguous and costs nothing.
    const float INF = uintBitsToFloat(0x7f800000u);
    // The COMPARE form, not isinf/isnan — same reason the HIP writes it this way: it does
    // not depend on the toolchain having left the predicates meaningful under -O. A NaN
    // fails both comparisons; +/-Inf fails one.
    if (!(v > -INF && v < INF)) {
        // FIRST writer wins, so the tag identifies the EARLIEST non-finite buffer in the
        // token rather than the last one dispatched. `atomicCompSwap(mem, compare, data)`
        // in GLSL is (mem == compare) ? data : mem, i.e. HIP's atomicCAS(flag, 0, tag).
        atomicCompSwap(pc.flag.v[0], 0u, pc.tag);
    }
}
