// qabs[head][i] = Σ_d q[head·qh + d] · e4m3(kv_b[rbase+d][i]) · scale[block(rbase+d, i)],
// rbase = head·(nope+vh), i∈[0,kvl), d∈[0,nope) — absorb q_nope through kv_b's nope rows
// into latent space. GLSL twin of mla.hip::mla_absorb_fp8.
//
// NOT a dot_fp8_wave caller, and that is the whole character of this kernel. Every other
// fp8 kernel here fixes a weight ROW and walks the column, so one wave cooperates on one
// contiguous row and the block scale advances along i. This one is TRANSPOSED: one thread
// owns a column `i` and walks DOWN the rows d, so the scale index has the ROW varying and
// the COLUMN fixed — `scale[(row>>bsh)*sc_cols + (i>>bsh)]`, striding by sc_cols per step
// instead of by one. There is no shared MAC to reuse and its oracle cannot be a reuse
// either.
//
// One thread per (head, i); adjacent threads read adjacent bytes of a row.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "common.glsl"

// ROWS_PER_BLOCK*WAVE, which is 256 today — the same value HIP's dim3(256) uses, but
// derived from build.rs's constants rather than written again. A second literal 256 here
// and in the launcher's group arithmetic would be two declarations with nothing checking
// them: if they disagreed the launcher would dispatch too few workgroups and the tail of
// qabs would keep its previous contents. No fault, no validation message, wrong numbers.
#define ABS_THREADS (ROWS_PER_BLOCK * WAVE)

// The >= 256-thread requirement E4M3_LUT_BUILD imposes is checked once, in fp8.glsl,
// which every LUT-building kernel includes.
layout(local_size_x = ABS_THREADS) in;

// Declared before the include; fp8.glsl's MAC reads it by name (rule 11). This kernel is
// transposed and does not call that MAC, but it shares the LUT convention and the packed
// word-reader type, and an unreferenced function is dead-code-eliminated.
shared float lut[256];
#include "fp8.glsl"

layout(push_constant) uniform Push {
    RoF32 q;
    uint64_t kvb;
    RoF32 scale;
    RwF32 qabs;
    int H;
    int qh;
    int nope;
    int vh;
    int kvl;
    int block;
} pc;

void main() {
    uint tid = gl_LocalInvocationID.x;
    E4M3_LUT_BUILD(lut, tid);
    barrier();

    uint idx = gl_WorkGroupID.x * ABS_THREADS + tid;
    if (idx >= uint(pc.H) * uint(pc.kvl)) return;

    uint head = idx / uint(pc.kvl);
    uint i = idx % uint(pc.kvl);
    uint sc_cols = (uint(pc.kvl) + uint(pc.block) - 1u) / uint(pc.block);
    int bsh = blk_shift(pc.block);
    uint rbase = head * uint(pc.nope + pc.vh);
    // q's per-head slice; the absorb reads its first `nope` entries.
    uint qoff = head * uint(pc.qh);

    // INDEX CEILING, per docs/reference/vulkan-kernels.md, "Index width". Largest index is the byte offset `row * kvl`:
    // row < H·(nope+vh) = 64·448 = 28672 and kvl = 512 at GLM dims, so it peaks near
    // 1.47e7 — ~292x clear of the 32-bit wrap. Computed in 64-bit regardless, since the
    // weight base is a device address.
    float acc = 0.0;
    for (uint d = 0u; d < uint(pc.nope); ++d) {
        uint row = rbase + d;
        // One BYTE per thread per step, read as the containing 32-bit word and shifted:
        // VK_KHR_8bit_storage is deliberately not required (docs/reference/vulkan-kernels.md, "Device requirements"). Adjacent
        // threads own adjacent `i`, so the four lanes sharing a word read it together.
        uint64_t off = uint64_t(row) * uint64_t(pc.kvl) + uint64_t(i);
        uint word = RoU32(pc.kvb + (off & ~3ul)).v[0];
        uint b = (word >> ((uint(off) & 3u) * 8u)) & 0xffu;
        // The transposed scale gather: row varies with d, column i is fixed.
        float w = lut[b] * pc.scale.v[(row >> uint(bsh)) * sc_cols + (i >> uint(bsh))];
        acc += pc.q.v[qoff + d] * w;
    }
    pc.qabs.v[head * uint(pc.kvl) + i] = acc;
}
