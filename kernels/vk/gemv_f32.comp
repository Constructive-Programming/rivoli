// y[o] = Σ_i x[i]·w[o·i_dim+i] — plain f32 GEMV (the MoE router gate).
// GLSL twin of linalg.hip::gemv_f32; ONE subgroup cooperates on one output row,
// adjacent lanes read adjacent columns (coalesced), then the fixed wave_sum ladder.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require

#include "common.glsl"

layout(local_size_x = ROWS_PER_BLOCK * WAVE) in;

// Buffers arrive as device ADDRESSES in the push constant, not as descriptor
// bindings — the direct translation of HIP's raw kernel pointer args, and the reason
// this backend needs no descriptor sets at all (see docs/VULKAN.md).

layout(push_constant) uniform Push {
    RoF32 x;
    RoF32 w;
    RwF32 y;
    int o_dim;
    int i_dim;
} pc;

void main() {
    uint lane = gl_SubgroupInvocationID;
    // Valid only while gl_NumSubgroups == ROWS_PER_BLOCK, i.e. while local_size_x /
    // requiredSubgroupSize == ROWS_PER_BLOCK. The pipeline pins requiredSubgroupSize
    // to WAVE and the launcher's grid is o_dim/ROWS_PER_BLOCK, so they agree by
    // construction today. Under the wave64 fallback docs/VULKAN.md lists as a risk,
    // gl_NumSubgroups would drop to 4 and rows 4..7 of EVERY workgroup would simply
    // never be written — y keeps its previous contents, no fault, no diagnostic. The
    // oracle catches it; nothing else would.
    uint o = gl_WorkGroupID.x * ROWS_PER_BLOCK + gl_SubgroupID;
    // Uniform across the subgroup (o depends only on gl_SubgroupID), so the whole
    // subgroup exits together and wave_sum below always runs fully populated.
    if (o >= uint(pc.o_dim)) return;
    uint row = o * uint(pc.i_dim);
    float acc = 0.0;
    for (uint i = lane; i < uint(pc.i_dim); i += WAVE) acc += pc.x.v[i] * pc.w.v[row + i];
    acc = wave_sum(acc);
    if (lane == 0) pc.y.v[o] = acc;
}
