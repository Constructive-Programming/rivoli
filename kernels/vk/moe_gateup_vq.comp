// Pass 1 of the fused VQ-int3 MoE expert batch:
//   h[e·inter + j] = silu(gate_ej·x) · (up_ej·x)
// One WAVE per (expert, row). GLSL twin of moe.hip::moe_gateup_vq.
//
// Processes the ABSOLUTE expert range [e_start, e_start+e_count) and writes its own `h`
// rows, so the streaming pipeline can launch experts (or a subrange) independently and
// they all land in the same schedule-independent `h`.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "common.glsl"
#include "vq.glsl"

layout(local_size_x = ROWS_PER_BLOCK * WAVE) in;

// The per-expert descriptor is SIX DEVICE ADDRESSES, laid out exactly as
// moe.hip::ExpertDescVq: gate_indices, gate_scales, up_indices, up_scales, down_indices,
// down_scales. This is the kernel the buffer-device-address requirement was written for —
// experts live at arbitrary offsets (resident shared or cold stream slots) and are reached
// without any gather or repack.
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer RoDesc {
    uint64_t v[];
};
#define DESC_FIELDS 6
#define D_GATE_IDX 0
#define D_GATE_SCL 1
#define D_UP_IDX   2
#define D_UP_SCL   3

layout(push_constant) uniform Push {
    RoF32 x;
    uint64_t descs;
    uint64_t gate_cb;
    uint64_t up_cb;
    RwF32 h_out;
    int hidden;
    int inter;
    int e_start;
    int e_count;
} pc;

// vq_row_bytes / vq_groups for a projection whose reduction dim is `i_dim`.
uint64_t vq_rb(int i_dim) { return uint64_t(i_dim / VQ_DIM) * VQ_INDEX_BITS / 8ul; }
uint64_t vq_ng(int i_dim) { return uint64_t(i_dim) / VQ_GROUP; }

void main() {
    uint lane = gl_SubgroupInvocationID;
    uint r = gl_WorkGroupID.x * ROWS_PER_BLOCK + gl_SubgroupID;
    if (r >= uint(pc.e_count) * uint(pc.inter)) return;

    uint e = uint(pc.e_start) + r / uint(pc.inter);
    uint j = r % uint(pc.inter);
    RoDesc d = RoDesc(pc.descs + uint64_t(e) * uint64_t(DESC_FIELDS) * 8ul);

    uint64_t rb = vq_rb(pc.hidden);
    uint64_t ng = vq_ng(pc.hidden);
    // The bf16 scale row is `ng` HALF-WORDS in, not bytes — the HIP pointer is
    // `unsigned short*`, so its arithmetic scales by 2.
    float g = dot_vq_wave(pc.x, d.v[D_GATE_IDX] + uint64_t(j) * rb,
                          d.v[D_GATE_SCL] + uint64_t(j) * ng * 2ul,
                          pc.gate_cb, pc.hidden, lane);
    float u = dot_vq_wave(pc.x, d.v[D_UP_IDX] + uint64_t(j) * rb,
                          d.v[D_UP_SCL] + uint64_t(j) * ng * 2ul,
                          pc.up_cb, pc.hidden, lane);

    // LANE 0 ONLY — wave_sum leaves every other lane undefined under SPIR-V.
    // `silu` carries the pre-registered `exp` divergence, same as swiglu: measured at
    // 1463/4096 differing outputs, and reproducing hipcc's expf reduction did not close
    // it (tests/xbackend.rs). Nothing new is decided here.
    if (lane == 0u) pc.h_out.v[e * uint(pc.inter) + j] = (g / (1.0 + exp(-g))) * u;
}
