// out[o] = Σ_e partial[e][o], e ASCENDING. GLSL twin of moe.hip::moe_reduce.
//
// THE PARTITION CARRIES NO FREEDOM, AND THAT IS BY DESIGN RATHER THAN BY LUCK.
//
// docs/VULKAN.md records that a work partition feeding an order-sensitive reduction is a
// numerics decision wearing a scheduling costume — `mla_plan_splits` is the worked example,
// where two backends cutting the rows differently produce different bits while both look
// correct. This kernel is the same shape and needed the same scrutiny, so it is worth
// stating why the answer here is "nothing to pin".
//
// The streaming pipeline launches experts in arbitrary ABSOLUTE ranges [e_start, e_count),
// on independent streams, in whatever order their weights finish loading. But
// `moe_down_vq` writes each expert to its OWN row of `partial`, indexed by the absolute
// `e` — no atomics, no accumulation across launches. So the schedule decides only WHEN a
// row is written, never WHERE, and this kernel then sums rows 0..e_count-1 in a fixed
// ascending order regardless of how they were produced.
//
// That is the freedom being ELIMINATED rather than matched: the launch partition cannot
// reach the summation order at all, so there is no compiler or scheduler choice to agree
// with. Had the HIP accumulated into a shared output instead, the partition WOULD have
// been load-bearing and the two backends would have had to cut experts identically.
//
// One f32 add per step and no multiply, so unlike the VQ dot there is no contraction to
// pin either.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "common.glsl"

layout(local_size_x = ROWS_PER_BLOCK * WAVE) in;

layout(push_constant) uniform Push {
    RoF32 partial;
    RwF32 out_;
    int e_count;
    int hidden;
} pc;

void main() {
    uint o = gl_GlobalInvocationID.x;
    if (o >= uint(pc.hidden)) return;
    float acc = 0.0;
    for (uint e = 0u; e < uint(pc.e_count); ++e) {
        acc += pc.partial.v[e * uint(pc.hidden) + o];
    }
    pc.out_.v[o] = acc;
}
