// ctx[head][j] = Σ_i clat[head][i] · e4m3(kv_b[rbase+nope+j][i]) · scale[block(row,i)],
// j∈[0,vh), i∈[0,kvl) — project the attention-weighted latent through kv_b's value rows.
// GLSL twin of mla.hip::mla_value_fp8.
//
// Per-head-row GEMV, one WAVE per output row. The block scale varies along i, so it is
// folded inside the dot rather than applied after — which is exactly what fp8.glsl's
// shared MAC does, and why this kernel is a caller rather than a reimplementation.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "common.glsl"

#define THREADS (ROWS_PER_BLOCK * WAVE)

layout(local_size_x = THREADS) in;

// Declared before the include; fp8.glsl's MAC reads it by name (rule 11).
shared float lut[256];
#include "fp8.glsl"

layout(push_constant) uniform Push {
    RoF32 clat;
    uint64_t kvb;
    RoF32 scale;
    RwF32 ctx;
    int H;
    int nope;
    int vh;
    int kvl;
    int block;
    int _pad;
} pc;

void main() {
    uint tid = gl_LocalInvocationID.x;
    E4M3_LUT_BUILD(lut, tid);
    barrier();

    uint lane = gl_SubgroupInvocationID;
    uint r = gl_WorkGroupID.x * ROWS_PER_BLOCK + gl_SubgroupID;
    if (r >= uint(pc.H) * uint(pc.vh)) return;

    uint head = r / uint(pc.vh);
    uint j = r % uint(pc.vh);
    uint sc_cols = (uint(pc.kvl) + uint(pc.block) - 1u) / uint(pc.block);
    // The value rows sit after the nope (absorb) rows within each head's row group.
    uint row = head * uint(pc.nope + pc.vh) + uint(pc.nope) + j;

    // INDEX CEILING, recorded per the rule in docs/VULKAN.md. The largest index here is
    // the byte offset `row * kvl`: at GLM dims row < H·(nope+vh) = 64·448 = 28672 and
    // kvl = 512, so it peaks near 1.47e7 — about 292x clear of the 32-bit wrap. It is
    // computed in 64-bit anyway, because the shared MAC takes a device address and
    // gemv_fp8 (lm_head-class shapes) genuinely needs the width.
    uint64_t wrow = pc.kvb + uint64_t(row) * uint64_t(pc.kvl);
    RoF32 xrow = RoF32(uint64_t(pc.clat) + uint64_t(head) * uint64_t(pc.kvl) * 4ul);
    RoF32 scalerow =
        RoF32(uint64_t(pc.scale) + uint64_t((row >> uint(blk_shift(pc.block))) * sc_cols) * 4ul);

    float acc = dot_fp8_wave(xrow, wrow, scalerow, pc.kvl, pc.block, lane);
    // LANE 0 ONLY — wave_sum's shuffle ladder leaves every other lane undefined here,
    // unlike HIP's __shfl_down. See common.glsl.
    if (lane == 0u) pc.ctx.v[head * uint(pc.vh) + j] = acc;
}
