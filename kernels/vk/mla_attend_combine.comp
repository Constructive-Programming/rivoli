// Merge the per-split partials into the final `clat`. GLSL twin of
// attn.hip::mla_attend_combine. One block per head.
//
// Each split stored acc_s = Σ exp(s_t − m_s)·L_t and l_s = Σ exp(s_t − m_s). Rescaling by
// w_s = exp(m_s − m_global) turns acc_s into Σ exp(s_t − m_global)·L_t exactly; summing
// and dividing by Σ w_s·l_s is the same globally-max-shifted softmax the single-block
// kernel computes. Both reductions walk splits in ASCENDING ORDER, so the result is
// schedule-independent — greedy decode needs that.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "common.glsl"

#define COMBINE_THREADS 256
#define MLA_MAX_SPLITS 16

layout(local_size_x = COMBINE_THREADS) in;

shared float w[MLA_MAX_SPLITS];   // exp(m_s − m_global) per split
shared float inv_l;

layout(push_constant) uniform Push {
    RoF32 partial;
    RwF32 clat;
    int H;
    int kvl;
    int n_splits;
    int max_splits;
} pc;

// GLSL HAS NO `isfinite`, AND THE POLARITY IS THE TRAP. It must be composed, and getting
// it backwards does not fail loudly — it zeroes EVERY split weight instead of guarding the
// empty-split case, so the output becomes silently zero rather than wrong-looking.
bool finite(float x) { return !isinf(x) && !isnan(x); }

void main() {
    uint head = gl_WorkGroupID.x;
    if (head >= uint(pc.H)) return;
    // The (m, l) pairs live after all the accumulators.
    uint ml = uint(pc.max_splits) * uint(pc.H) * uint(pc.kvl);

    if (gl_LocalInvocationID.x == 0u) {
        float m_g = -1.0 / 0.0;
        for (uint s = 0u; s < uint(pc.n_splits); ++s)
            m_g = max(m_g, pc.partial.v[ml + (s * uint(pc.H) + head) * 2u]);
        // m_g non-finite ⇒ every split empty (or every score −inf): exp(m_s − m_g) would
        // be NaN, so short-circuit to the zero output the single-block kernel's
        // `l > 0 ? 1/l : 0` guard also produces.
        float l_g = 0.0;
        for (uint s = 0u; s < uint(pc.n_splits); ++s) {
            uint o = ml + (s * uint(pc.H) + head) * 2u;
            w[s] = finite(m_g) ? exp(pc.partial.v[o] - m_g) : 0.0;
            l_g = fma(pc.partial.v[o + 1u], w[s], l_g);
        }
        inv_l = l_g > 0.0 ? 1.0 / l_g : 0.0;
    }
    memoryBarrierShared();
    barrier();

    for (uint i = gl_LocalInvocationID.x; i < uint(pc.kvl); i += COMBINE_THREADS) {
        float sum = 0.0;
        // Ascending split order, one multiply per add — no contraction ambiguity here,
        // unlike the accumulator update in mla_latent_attend.
        for (uint s = 0u; s < uint(pc.n_splits); ++s)
            sum = fma(pc.partial.v[(s * uint(pc.H) + head) * uint(pc.kvl) + i], w[s], sum);
        pc.clat.v[head * uint(pc.kvl) + i] = sum * inv_l;
    }
}
