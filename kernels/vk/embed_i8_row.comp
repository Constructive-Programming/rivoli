// x[i] = (int8)packed[token*hidden + i] * scale[token] — embedding row lookup.
// GLSL twin of fwd.hip::embed_i8_row.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "common.glsl"

layout(local_size_x = ROWS_PER_BLOCK * WAVE) in;

// Packed int8 is read as UINT WORDS and unpacked by hand — VK_KHR_8bit_storage is
// deliberately not required (docs/VULKAN.md), and the hot loops unpack manually anyway.
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer RoU32 { uint v[]; };

layout(push_constant) uniform Push {
    RoU32 packed;
    RoF32 scale;
    RwF32 x;
    int token;
    int hidden;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.hidden)) return;

    // 64-BIT, and this is the kernel that needs it. embed is [vocab, hidden] =
    // 151552 x 5120 = 7.76e8 bytes for GLM-5.2 — only 5.5x under the 2^32 ceiling, and
    // a wrap would read silently from another allocation rather than fault. Same shape
    // as lm_head. See docs/VULKAN.md, "Index width".
    uint64_t byte_off = uint64_t(pc.token) * uint64_t(pc.hidden) + uint64_t(i);

    // Address the containing 32-bit word directly rather than indexing `v[]` with a
    // truncated 32-bit index, which would defeat the whole point. Buffer references are
    // byte-addressed, so this stays exact past 4 GiB.
    uint64_t word_addr = uint64_t(pc.packed) + (byte_off & ~3ul);
    uint word = RoU32(word_addr).v[0];

    // Sign-extend the selected byte: shift it to the top of the word, then an
    // ARITHMETIC right shift back. Reading it as unsigned is the obvious bug here and
    // shows up only on values >= 0x80, which is why the oracle feeds negatives.
    uint shift = uint(byte_off & 3ul) * 8u;
    int b = int(word << (24u - shift)) >> 24;

    pc.x.v[i] = float(b) * pc.scale.v[pc.token];
}
