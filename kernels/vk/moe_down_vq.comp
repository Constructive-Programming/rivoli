// Pass 2 of the fused VQ-int3 MoE expert batch:
//   acc[o] += fixed(w[e] · (down_eo · h[e]))
// One WAVE per (expert, row). GLSL twin of moe.hip::moe_down_vq.
//
// Every expert accumulates into ONE row, atomically, in fixed point. The result is
// schedule-independent not because the writes are disjoint but because integer addition
// is associative — a stronger property, and the one that let the reduce and the
// cross-stream join leave the decode path. See common.glsl's MOE_ACC block.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_atomic_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "common.glsl"
#include "vq.glsl"

layout(local_size_x = ROWS_PER_BLOCK * WAVE) in;

// Same six-address descriptor as moe_gateup_vq; this pass reads the last two.
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer RoDesc {
    uint64_t v[];
};
#define DESC_FIELDS 6
#define D_DOWN_IDX 4
#define D_DOWN_SCL 5

layout(push_constant) uniform Push {
    uint64_t descs;
    uint64_t down_cb;
    RoF32 wexpert;
    RoF32 h_in;
    RwU64 acc;
    int hidden;
    int inter;
    int e_start;
    int e_count;
} pc;

uint64_t vq_rb(int i_dim) { return uint64_t(i_dim / VQ_DIM) * VQ_INDEX_BITS / 8ul; }
uint64_t vq_ng(int i_dim) { return uint64_t(i_dim) / VQ_GROUP; }

void main() {
    uint lane = gl_SubgroupInvocationID;
    uint r = gl_WorkGroupID.x * ROWS_PER_BLOCK + gl_SubgroupID;
    if (r >= uint(pc.e_count) * uint(pc.hidden)) return;

    uint e = uint(pc.e_start) + r / uint(pc.hidden);
    uint o = r % uint(pc.hidden);
    RoDesc d = RoDesc(pc.descs + uint64_t(e) * uint64_t(DESC_FIELDS) * 8ul);

    // The reduction dim here is `inter`, not `hidden` — down_proj is the transpose of the
    // gate/up shape, and getting this backwards would index a valid but wrong row.
    uint64_t rb = vq_rb(pc.inter);
    uint64_t ng = vq_ng(pc.inter);
    RoF32 he = RoF32(uint64_t(pc.h_in) + uint64_t(e) * uint64_t(pc.inter) * 4ul);

    float dv = dot_vq_wave(he, d.v[D_DOWN_IDX] + uint64_t(o) * rb,
                           d.v[D_DOWN_SCL] + uint64_t(o) * ng * 2ul,
                           pc.down_cb, pc.inter, lane);

    // LANE 0 ONLY. One multiply, no add — no contraction ambiguity to pin here, unlike
    // the dot itself.
    if (lane == 0u) atomicAdd(pc.acc.v[o], moe_fixed(pc.wexpert.v[e] * dv));
}
