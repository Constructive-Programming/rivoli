/target*
/glm52-fp8/
# docs/probes/* are standalone crates with their own build dirs; the rooted pattern
# above does not reach them.
target/

# harness working state (worktrees, agent patches, session scratch) — but SKILLS are
# project knowledge and ship with the repo, so they are re-included. This is `.claude/*`
# rather than `.claude/` because git cannot re-include a path inside an excluded
# DIRECTORY; the negation below is inert unless the parent is matched per-entry.
.claude/*
!.claude/skills/
.snapshot_path

# python bytecode from `tests/k3_anchor_driver.py` when it is imported as a module (the
# `--compare` path does that). `build.rs` scans `tests/`, so committed .pyc would be scanned.
__pycache__/
